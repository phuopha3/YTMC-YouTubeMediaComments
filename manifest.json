{
  "manifest_version": 3,
  "name": "YTMC — YouTube Media Comments",
  "version": "1.0.2",
  "description": "Bring images and GIFs to your comments and to everyone on YouTube with YTMC.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.imgbb.com/*",
    "https://api.giphy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
